# Copy to deploy/.env. Every variable is required; an empty value disables an optional feature explicitly.
# Sizing below is for an 8 vCPU / 32 GB host.

# --- collector ---
# host:port the collector is published on (put your TLS reverse proxy in front)
COLLECTOR_PUBLISH=127.0.0.1:8080
# Comma-separated exact origins allowed to POST /e
ALLOWED_ORIGINS=https://www.example.com,https://example.com
# Bounded producer queue (messages = request batches); full queue -> 503
QUEUE_MAX_MESSAGES=100000
# In-container path to GeoLite2-City.mmdb (put the file in deploy/geoip/); empty = no geo enrichment
GEOIP_DB_PATH=
# Header set by your reverse proxy (last hop is used), e.g. x-forwarded-for; empty = TCP peer address
CLIENT_IP_HEADER=
RUST_LOG=info
COLLECTOR_CPUS=2
COLLECTOR_MEMORY=1g

# --- redpanda ---
KAFKA_TOPIC=events
KAFKA_PARTITIONS=2
KAFKA_RETENTION_MS=604800000
REDPANDA_CPUS=2
# Redpanda's own memory, and the container limit above it
REDPANDA_MEMORY=3G
REDPANDA_MEMORY_LIMIT=4g

# --- clickhouse ---
CLICKHOUSE_HTTP_PUBLISH=127.0.0.1:8123
CLICKHOUSE_DB=pawlog
CLICKHOUSE_USER=pawlog
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DASHBOARD_PASSWORD=change-me-too
CLICKHOUSE_KAFKA_GROUP=clickhouse_events
CLICKHOUSE_CPUS=4
CLICKHOUSE_MEMORY=16g

# --- dashboard (sites it shows: deploy/sites.yml, from sites.example.yml) ---
DASHBOARD_PUBLISH=127.0.0.1:3000
# generate with: openssl rand -hex 64
DASHBOARD_SECRET_KEY_BASE=change-me
# true behind a TLS-terminating proxy (https only), false for plain-http local use
DASHBOARD_FORCE_SSL=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
