<% content_for :title, "#{site.id} · #{@path}" %>
<div class="page-head"><h1><%= @path %> <%= link_to "heatmap", heatmap_path(scope(path: @path)), class: "small" %></h1><%= render "shared/range" %></div>
<section class="card">
<div class="kpis">
  <% t = @totals || {} %>
  <div class="kpi" data-kpi="pageviews"><span class="label">Views</span><span class="value"><%= num(t["pageviews"]) %></span></div>
  <div class="kpi" data-kpi="visitors"><span class="label">Active users</span><span class="value"><%= num(t["visitors"]) %></span></div>
  <div class="kpi" data-kpi="avg_engaged"><span class="label">Avg engaged</span><span class="value"><%= secs(t["avg_engaged_ms"].to_f / 1000) %></span></div>
  <div class="kpi" data-kpi="entries"><span class="label">Entries</span><span class="value"><%= num(@entry_exit["entries"]) %></span></div>
  <div class="kpi" data-kpi="exits"><span class="label">Exits</span><span class="value"><%= num(@entry_exit["exits"]) %></span></div>
  <div class="kpi" data-kpi="bounces"><span class="label">Bounces</span><span class="value"><%= num(@entry_exit["bounces"]) %></span></div>
</div>
<%= bars(@series, key: "pageviews", label: ->(r) { r["day"] }, aria: "views per day") %>
</section>
<section class="card"><%= render "shared/table", rows: @series, cols: [ [ "Day", "day" ], [ "Views", "pageviews", method(:num) ], [ "Active users", "visitors", method(:num) ] ] %></section>
