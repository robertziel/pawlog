<% content_for :title, "#{site.id} · overview" %>
<section class="kpis">
  <% [ [ "Visitors", "visitors", :num, false ], [ "Pageviews", "pageviews", :num, false ], [ "Sessions", "sessions", :num, false ],
       [ "Bounce", "bounce_rate", :pct, true ], [ "Avg duration", "avg_duration_s", :secs, false ] ].each do |label, k, fmt, lower| %>
    <div class="kpi" data-kpi="<%= k %>">
      <span class="label"><%= label %></span>
      <span class="value"><%= send(fmt, @current[k]) %></span>
      <%= delta(@current[k], @previous[k], lower_is_better: lower) %>
      <span class="prev">prev <%= send(fmt, @previous[k]) %></span>
    </div>
  <% end %>
</section>
<p class="meta"><%= range.begin %> → <%= range.end %> vs <%= @previous_range.begin %> → <%= @previous_range.end %> (UTC)</p>
<%= bars(@series) %>
<div class="grid2">
  <section><h2>Top pages</h2>
    <%= render "shared/table", rows: @pages, link: ->(r) { page_path(scope(path: r["path"])) },
          cols: [ [ "Path", "path" ], [ "Views", "pageviews", method(:num) ], [ "Visitors", "visitors", method(:num) ], [ "Avg engaged", "avg_engaged_ms", ->(v) { secs(v.to_f / 1000) } ] ] %></section>
  <section><h2>Sources</h2>
    <%= render "shared/table", rows: @sources,
          cols: [ [ "Referrer", "ref_domain" ], [ "utm_source", "utm_source" ], [ "utm_medium", "utm_medium" ], [ "utm_campaign", "utm_campaign" ], [ "Visits", "visits", method(:num) ], [ "Visitors", "visitors", method(:num) ] ] %></section>
  <section><h2>Countries</h2>
    <%= render "shared/table", rows: @countries, cols: [ [ "Country", "value" ], [ "Sessions", "sessions", method(:num) ], [ "Visitors", "visitors", method(:num) ] ] %></section>
  <section><h2>Devices</h2>
    <%= render "shared/table", rows: @devices, cols: [ [ "Device", "value" ], [ "Sessions", "sessions", method(:num) ], [ "Visitors", "visitors", method(:num) ] ] %></section>
</div>
