<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "pawlog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app %>
    <%= yield :head %>
  </head>
  <body class="<%= "app" if authenticated? %>">
    <% if authenticated? %>
      <header class="top">
        <%= link_to root_path(site: site.id), class: "brand" do %><img src="/icon.svg" alt="" width="26" height="26">pawlog<% end %>
        <details class="menu">
          <summary><small>Site</small> <%= site.id %> ▾</summary>
          <div class="pop"><% Site.all.each do |s| %><%= link_to s.id, here(site: s.id), class: ("on" if s.id == site.id) %><% end %></div>
        </details>
        <%= button_to "Sign out", session_path, method: :delete, class: "signout" %>
      </header>
      <nav class="side" aria-label="sections">
        <%= link_to "Home", root_path(scope), class: ("on" if controller_name == "home") %>
        <h3>Reports</h3>
        <%= link_to "Reports snapshot", reports_path(scope), class: ("on" if controller_name.in?(%w[overview pages])) %>
        <%= link_to "Realtime overview", realtime_path(site: site.id), class: ("on" if action_name == "show" && controller_name == "realtime") %>
        <%= link_to "Realtime pages", realtime_pages_path(site: site.id), class: ("on" if action_name == "pages") %>
        <h3>Explore</h3>
        <%= link_to "Heatmaps", heatmap_path(scope), class: ("on" if controller_name == "heatmaps") %>
      </nav>
    <% end %>
    <main><%= yield %></main>
  </body>
</html>
